{
  "manifest_version": 3,
  "name": "Bela na disputa",
  "version": "0.5.0",
  "description": "Lê o melhor lance e o chat do pregoeiro na sessão que você já tem aberta, avisa quando chamam a sua empresa e escreve o lance sugerido no campo do portal para você conferir e enviar. Não envia lance e não guarda senha.",
  "permissions": [
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "*://*.compras.gov.br/*",
    "*://*.comprasnet.gov.br/*",
    "*://*.estaleiro.serpro.gov.br/*",
    "https://*.licitabela.com.br/*",
    "https://licita-es-v2-4.vercel.app/*",
    "http://localhost/*",
    "https://api-production-4375e.up.railway.app/*"
  ],
  "background": {
    "service_worker": "fundo.mjs",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bela na disputa",
    "default_icon": {
      "16": "icone-16.png",
      "48": "icone-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.compras.gov.br/*",
        "*://*.comprasnet.gov.br/*",
        "*://*.estaleiro.serpro.gov.br/*"
      ],
      "js": [
        "carregador-disputa.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.licitabela.com.br/*",
        "https://licita-es-v2-4.vercel.app/*",
        "http://localhost/*"
      ],
      "js": [
        "carregador-app.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "conteudo-disputa.mjs",
        "conteudo-app.mjs",
        "config.mjs",
        "lib/valor.mjs",
        "lib/captura.mjs",
        "lib/chat.mjs",
        "lib/preencher.mjs"
      ],
      "matches": [
        "*://*.compras.gov.br/*",
        "*://*.comprasnet.gov.br/*",
        "*://*.estaleiro.serpro.gov.br/*",
        "https://*.licitabela.com.br/*",
        "https://licita-es-v2-4.vercel.app/*",
        "http://localhost/*"
      ]
    }
  ],
  "icons": {
    "16": "icone-16.png",
    "48": "icone-48.png",
    "128": "icone-128.png"
  }
}
