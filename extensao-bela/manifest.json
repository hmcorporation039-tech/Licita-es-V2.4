{
  "manifest_version": 3,
  "name": "Bela na disputa",
  "version": "0.7.0",
  "description": "Lê o melhor lance e o chat do pregoeiro na sessão que você já tem aberta (Compras.gov.br, BLL, LicitaNet, Portal de Compras Públicas e outros), avisa quando chamam a sua empresa e escreve o lance sugerido no campo para você conferir e enviar. Não envia lance e não guarda senha.",
  "permissions": [
    "storage",
    "notifications",
    "sidePanel"
  ],
  "host_permissions": [
    "*://*.compras.gov.br/*",
    "*://*.comprasnet.gov.br/*",
    "*://*.estaleiro.serpro.gov.br/*",
    "*://*.portaldecompraspublicas.com.br/*",
    "*://*.licitacoes-e.com.br/*",
    "*://*.bll.org.br/*",
    "*://*.bllcompras.com/*",
    "*://*.bllcompras.com.br/*",
    "*://*.bnc.org.br/*",
    "*://*.licitardigital.com.br/*",
    "*://*.ammlicita.org.br/*",
    "*://*.licitanet.com.br/*",
    "*://*.bec.sp.gov.br/*",
    "*://*.bec.fazenda.sp.gov.br/*",
    "*://*.comprasbr.com.br/*",
    "*://*.publinexo.com.br/*",
    "*://portaldecompraspublicas.com.br/*",
    "*://licitacoes-e.com.br/*",
    "*://bll.org.br/*",
    "*://bllcompras.com/*",
    "*://bllcompras.com.br/*",
    "*://bnc.org.br/*",
    "*://licitardigital.com.br/*",
    "*://ammlicita.org.br/*",
    "*://licitanet.com.br/*",
    "*://bec.sp.gov.br/*",
    "*://bec.fazenda.sp.gov.br/*",
    "*://comprasbr.com.br/*",
    "*://publinexo.com.br/*",
    "https://*.licitabela.com.br/*",
    "https://licita-es-v2-4.vercel.app/*",
    "http://localhost/*",
    "https://api-production-4375e.up.railway.app/*"
  ],
  "background": {
    "service_worker": "fundo.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "Bela na disputa",
    "default_icon": {
      "16": "icone-16.png",
      "48": "icone-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.compras.gov.br/*",
        "*://*.comprasnet.gov.br/*",
        "*://*.estaleiro.serpro.gov.br/*",
        "*://*.portaldecompraspublicas.com.br/*",
        "*://*.licitacoes-e.com.br/*",
        "*://*.bll.org.br/*",
        "*://*.bllcompras.com/*",
        "*://*.bllcompras.com.br/*",
        "*://*.bnc.org.br/*",
        "*://*.licitardigital.com.br/*",
        "*://*.ammlicita.org.br/*",
        "*://*.licitanet.com.br/*",
        "*://*.bec.sp.gov.br/*",
        "*://*.bec.fazenda.sp.gov.br/*",
        "*://*.comprasbr.com.br/*",
        "*://*.publinexo.com.br/*",
        "*://portaldecompraspublicas.com.br/*",
        "*://licitacoes-e.com.br/*",
        "*://bll.org.br/*",
        "*://bllcompras.com/*",
        "*://bllcompras.com.br/*",
        "*://bnc.org.br/*",
        "*://licitardigital.com.br/*",
        "*://ammlicita.org.br/*",
        "*://licitanet.com.br/*",
        "*://bec.sp.gov.br/*",
        "*://bec.fazenda.sp.gov.br/*",
        "*://comprasbr.com.br/*",
        "*://publinexo.com.br/*"
      ],
      "js": [
        "carregador-disputa.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.licitabela.com.br/*",
        "https://licita-es-v2-4.vercel.app/*",
        "http://localhost/*"
      ],
      "js": [
        "carregador-app.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "conteudo-disputa.mjs",
        "conteudo-app.mjs",
        "config.mjs",
        "lib/valor.mjs",
        "lib/captura.mjs",
        "lib/chat.mjs",
        "lib/preencher.mjs",
        "lib/proposta.mjs"
      ],
      "matches": [
        "*://*.compras.gov.br/*",
        "*://*.comprasnet.gov.br/*",
        "*://*.estaleiro.serpro.gov.br/*",
        "*://*.portaldecompraspublicas.com.br/*",
        "*://*.licitacoes-e.com.br/*",
        "*://*.bll.org.br/*",
        "*://*.bllcompras.com/*",
        "*://*.bllcompras.com.br/*",
        "*://*.bnc.org.br/*",
        "*://*.licitardigital.com.br/*",
        "*://*.ammlicita.org.br/*",
        "*://*.licitanet.com.br/*",
        "*://*.bec.sp.gov.br/*",
        "*://*.bec.fazenda.sp.gov.br/*",
        "*://*.comprasbr.com.br/*",
        "*://*.publinexo.com.br/*",
        "*://portaldecompraspublicas.com.br/*",
        "*://licitacoes-e.com.br/*",
        "*://bll.org.br/*",
        "*://bllcompras.com/*",
        "*://bllcompras.com.br/*",
        "*://bnc.org.br/*",
        "*://licitardigital.com.br/*",
        "*://ammlicita.org.br/*",
        "*://licitanet.com.br/*",
        "*://bec.sp.gov.br/*",
        "*://bec.fazenda.sp.gov.br/*",
        "*://comprasbr.com.br/*",
        "*://publinexo.com.br/*",
        "https://*.licitabela.com.br/*",
        "https://licita-es-v2-4.vercel.app/*",
        "http://localhost/*"
      ]
    }
  ],
  "icons": {
    "16": "icone-16.png",
    "48": "icone-48.png",
    "128": "icone-128.png"
  },
  "side_panel": {
    "default_path": "popup.html"
  }
}
