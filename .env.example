# ============================================================
# .env.example — Copie para .env e preencha os valores
# ============================================================

# PostgreSQL. Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:senha@xxxxx.proxy.rlwy.net:12345/railway?schema=public"

# Supabase: o painel oferece duas conexoes e elas NAO sao intercambiaveis.
#   porta 6543 (pooler/pgbouncer) -> DATABASE_URL da aplicacao, com ?pgbouncer=true
#   porta 5432 (direta)           -> DIRECT_URL, usada so pelo Prisma Migrate
# Migration pelo pooler trava: o Prisma precisa de sessao real para tomar
# advisory lock e rodar DDL. Ver MIGRACAO.md.
# DIRECT_URL="postgresql://postgres:senha@db.xxxxx.supabase.co:5432/postgres"

# Redis (local em dev / Upstash ou Railway Plugin em prod)
REDIS_URL="redis://localhost:6379"

# Upstash Redis (alternativa gerenciada — copie da dashboard Upstash)
# REDIS_URL="rediss://default:TOKEN@xxxxx.upstash.io:6379"

# Ambiente
NODE_ENV="development"

# Autenticação — gere uma chave aleatória própria, não reaproveite esta
# (ex: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
JWT_SECRET=""

# Notificações por e-mail (Resend — https://resend.com)
RESEND_API_KEY=""
EMAIL_FROM="noreply@seudominio.com.br"

# --- Alertas ao administrador (erro 500, job de worker que falhou, pedido de exclusão LGPD) ---
# Webhook do Slack, Discord, Teams ou Google Chat e/ou e-mail. Sem nenhum dos dois, não há alerta.
# ALERT_WEBHOOK_URL="https://hooks.slack.com/services/..."
# ALERT_EMAIL="marcio@hemengetecnologia.com.br"

# --- Proteção do cadastro público ---
# Captcha Cloudflare Turnstile (grátis): a chave secreta vai na API; a pública, no site (Vercel).
# TURNSTILE_SECRET_KEY=""
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""   (no web/.env / Vercel)
# Teto de cadastros não confirmados por hora em toda a plataforma (padrão 60).
# CADASTRO_MAX_POR_HORA=60

# Origens de navegador aceitas, separadas por vírgula. OBRIGATÓRIA em produção:
# vazia em produção = nenhum navegador é aceito (antes o CORS aceitava qualquer site).
CORS_ORIGINS="http://localhost:3000"

# Teto de licitações reconsultadas por varredura de situação (rodízio).
# SITUACAO_MAX_POR_EXECUCAO="500"

# Teto GLOBAL de dias até o encerramento da proposta no feed de matches. Uma
# proposta que encerra depois disso (ou já encerrou) some do pool por padrão —
# use "60" para afrouxar. Licitação sem data de encerramento (comum em dispensa)
# não é afetada. Padrão 30.
# COLETA_PRAZO_MAX_DIAS="30"

# Importação automática das UASGs e do catálogo CATMAT/CATSER (alimenta o
# autocomplete do cadastro de item). Na API em produção já liga sozinha: importa
# se a tabela estiver vazia e renova a cada ~35 dias. "false" desliga; "true"
# liga fora de produção.
# AUTO_IMPORT_CATALOGOS="true"
# AUTO_IMPORT_MAX_IDADE_DIAS="35"

# Só para a suíte E2E, que faz dezenas de logins do mesmo IP. NUNCA em produção.
# RATE_LIMIT_DISABLED="false"

# ============================================================
# Análise de edital por IA
# ============================================================

# INTERRUPTOR GERAL. Com "false" (padrão), nenhuma chamada à API de IA é feita
# e nenhum crédito é gasto — a análise é marcada como DISABLED antes de
# qualquer download ou chamada de modelo. Ligue só quando quiser gastar.
AI_ANALYSIS_ENABLED="false"

# Troque AI_PROVIDER pra alternar sem mexer em código.
# "claude" (pago, melhor qualidade) ou "gemini" (gratuito, via Google AI Studio)
AI_PROVIDER="claude"

# Claude/Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=""

# Gemini/Google AI Studio — https://aistudio.google.com/apikey (gratuito)
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-3.5-flash-lite"  # opcional; o padrao do codigo ja e este

# ============================================================
# Cadastro público (2.4)
# ============================================================

# Endereço público do site, usado nos links dos e-mails de confirmação e de
# recuperação de senha. Sem ele, usa a primeira origem de CORS_ORIGINS.
# APP_URL="https://licita-es-v2-4.vercel.app"

# Dias de teste gratuito de uma conta criada pelo cadastro público (1 a 90). Padrão 14.
# TRIAL_DIAS="14"

# Preço por MILHÃO de tokens (USD) do modelo de IA em uso — só para estimar o
# custo no painel "Consumo de IA". Sem eles, o painel mostra apenas os tokens.
# AI_PRICE_INPUT_PER_MTOK=""
# AI_PRICE_OUTPUT_PER_MTOK=""

# ============================================================
# Análise de edital em DUPLA (2.4): o Gemini analisa e a Claude revisa
# ============================================================

# Com GEMINI_API_KEY e ANTHROPIC_API_KEY as duas preenchidas, a análise é feita em dupla
# automaticamente. AI_PIPELINE força um modo: "dupla" | "gemini" | "claude" (os dois últimos
# analisam sem revisão). Pedir "dupla" sem as duas chaves degrada com aviso no log.
# AI_PIPELINE="dupla"

# Modelo do REVISOR (Claude). Padrão: claude-opus-5-5, com raciocínio adaptativo e esforço "high".
# CLAUDE_REVIEW_MODEL="claude-opus-5-5"
# Esforço da revisão (low|medium|high|xhigh|max). Padrão high; "medium" é bem mais rápido e barato.
# CLAUDE_REVIEW_EFFORT="high"
# Análises simultâneas por worker (1 a 4, padrão 2).
# ANALISE_CONCURRENCY=2
# Quando a Claude revisa: "sempre" (padrão) ou "seletiva" (só se a análise tiver sinais de risco:
# nenhuma exigência, exigências não localizadas, PDF escaneado, campos-chave vazios).
# CLAUDE_REVIEW_MODE="sempre"
# No modo seletivo, valor estimado (R$) a partir do qual a revisão é sempre feita.
# CLAUDE_REVIEW_VALOR_ALTO=1000000

# Preço por MILHÃO de tokens (USD), um par por provedor, só para estimar o custo no painel
# "Consumo de IA". Confira os valores no site de cada provedor antes de preencher.
# AI_PRICE_GEMINI_INPUT_PER_MTOK=""
# AI_PRICE_GEMINI_OUTPUT_PER_MTOK=""
# AI_PRICE_CLAUDE_INPUT_PER_MTOK=""
# AI_PRICE_CLAUDE_OUTPUT_PER_MTOK=""
